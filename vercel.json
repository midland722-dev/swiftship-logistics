{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "rewrites": [
    { "source": "/deprixa/:path*", "destination": "https://php-app-production-7ce0.up.railway.app/deprixa/:path*" },
    { "source": "/php/:path*", "destination": "https://php-app-production-7ce0.up.railway.app/php/:path*" },
    { "source": "/api/:path*", "destination": "https://php-app-production-7ce0.up.railway.app/api/:path*" }
  ]
}
