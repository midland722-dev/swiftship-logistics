{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "redirects": [
    { "source": "/deprixa/:path*", "destination": "https://php-app-production-7ce0.up.railway.app/php/deprixa/:path*", "permanent": false },
    { "source": "/php/:path*", "destination": "https://php-app-production-7ce0.up.railway.app/php/:path*", "permanent": false }
  ]
}
