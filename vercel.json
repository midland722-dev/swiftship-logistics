{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "routes": [
    {
      "src": "/deprixa(?:/(.*))?",
      "dest": "https://${RAILWAY_BACKEND_URL}/deprixa/$1",
      "env": ["RAILWAY_BACKEND_URL"]
    },
    {
      "src": "/php(?:/(.*))?",
      "dest": "https://${RAILWAY_BACKEND_URL}/php/$1",
      "env": ["RAILWAY_BACKEND_URL"]
    },
    {
      "src": "/api(?:/(.*))?",
      "dest": "https://${RAILWAY_BACKEND_URL}/php/api/$1",
      "env": ["RAILWAY_BACKEND_URL"]
    }
  ]
}
